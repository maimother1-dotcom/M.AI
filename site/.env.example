# ---------------------------------------------------------------------------
# L'INDIENNE — environment
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way. Never commit a real key, and never echo one to a terminal or a log.
# ---------------------------------------------------------------------------

# Public base URL. Used for canonical URLs, the sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://lindienne.com

# --- Order signing --------------------------------------------------------
# REQUIRED IN PRODUCTION. Signs order tokens so a receipt cannot be forged by
# editing a URL. Minimum 32 characters; the app refuses to start without it in
# production. Generate one with:
#   openssl rand -base64 48
ORDER_SIGNING_SECRET=

# --- Stripe ---------------------------------------------------------------
# Leave all three blank to run in demo mode: the site works end to end, the
# payment page validates cards locally, and no money moves.
#
# Fill them in and the same payment page becomes Stripe's Payment Element with
# no code change.
#
# Secret key — SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Publishable key — safe in the browser. It can only create tokens.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret, from `stripe listen` or the Stripe dashboard.
# Without it the webhook endpoint refuses every request, which is correct.
STRIPE_WEBHOOK_SECRET=
