# ---------------------------------------------------------------------------
# L'INDIENNE — environment
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that
# way. Never commit a real key, and never echo one to a terminal or a log.
# ---------------------------------------------------------------------------

# Public base URL. Used for canonical URLs, the sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://lindienne.com

# --- Order signing --------------------------------------------------------
# REQUIRED IN PRODUCTION. Signs order tokens so a receipt cannot be forged by
# editing a URL. Minimum 32 characters; the app refuses to start without it in
# production. Generate one with:
#   openssl rand -base64 48
#
# It also encrypts the order store via a separately derived key. BACK IT UP
# somewhere other than the server: lose it or change it and every stored order
# becomes permanently unreadable.
ORDER_SIGNING_SECRET=

# --- Order storage --------------------------------------------------------
# Leave blank to store orders in data/orders.enc.json, which is durable on a
# single long-lived server and NOT durable on Vercel or any serverless host.
#
# Set it to a POOLED Postgres connection string to store them in a database —
# required on serverless, where production checkout refuses without one rather
# than take payment for an order that would vanish. The table is created on
# first use. Personal data is encrypted before it reaches the database, so your
# provider stores a blob it cannot read.
#   DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# --- Stripe ---------------------------------------------------------------
# Leave all three blank to run in demo mode: the site works end to end, the
# payment page validates cards locally, and no money moves.
#
# Fill them in and the same payment page becomes Stripe's Payment Element with
# no code change.
#
# Secret key — SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Publishable key — safe in the browser. It can only create tokens.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret, from `stripe listen` or the Stripe dashboard.
# Without it the webhook endpoint refuses every request, which is correct.
STRIPE_WEBHOOK_SECRET=

# --- Admin panel ----------------------------------------------------------
# Optional. Leave blank and /admin returns 404 — the panel does not exist on
# this deployment. Generate all four with:
#   npm run admin:setup -- you@example.com
#
# The password is stored only as a scrypt hash. TOTP is REQUIRED, not optional:
# a stolen password alone must not reach a surface that can change prices.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=

# --- Razorpay (recommended for India) -------------------------------------
# Stripe India is invite-only and does not support UPI, which rules it out for
# a rupee-priced store selling to Indian customers. Razorpay is RBI-licensed,
# settles INR domestically, and covers UPI, cards, netbanking and wallets.
#
# Set these and Razorpay takes precedence over Stripe automatically.
# Test keys start rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From the Razorpay dashboard: Settings → Webhooks. Without it the webhook
# endpoint rejects every request, which is the correct default.
RAZORPAY_WEBHOOK_SECRET=
