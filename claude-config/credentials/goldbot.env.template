# goldbot — broker credentials for the XAU/USD trading bot
#
# Copy to goldbot.env, fill in, then: chmod 600 ~/.claude/credentials/goldbot.env
# The bot reads this file at startup; the YAML config only holds ${VAR} names,
# so nothing secret ever lands in git.

# --- MetaTrader 5 (Windows) ---
# From your broker's account email, or MT5 → File → Login to Trade Account.
MT5_LOGIN=12345678
MT5_PASSWORD=your-trading-password
MT5_SERVER=YourBroker-Live

# --- OANDA v20 (any platform) ---
# Get them: OANDA account → Manage API Access → Generate token.
OANDA_TOKEN=your-v20-api-token
OANDA_ACCOUNT_ID=101-004-00000000-001
